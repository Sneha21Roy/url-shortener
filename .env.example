# Copy this file to .env and customize as needed.
# The app runs fine with the defaults below for local development.

SECRET_KEY=change-this-to-a-random-string
JWT_SECRET_KEY=change-this-to-a-different-random-string

# SQLite by default - fine for development / this assignment.
DATABASE_URL=sqlite:///url_shortener.db

# Used to build the short links shown to the user, e.g. http://localhost:5000/aZ3kP9
BASE_URL=http://localhost:5000
